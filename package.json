{
  "name": "multibank-ui-automation",
  "version": "1.0.0",
  "description": "Production-grade Playwright UI automation framework for MultiBank trading platform",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:desktop": "npx playwright test --project=chromium --project=firefox --project=webkit",
    "test:tablet": "npx playwright test --project=chromium-tablet --project=firefox-tablet --project=webkit-tablet",
    "test:ipad": "npx playwright test --project=chromium-ipad --project=firefox-ipad --project=webkit-ipad",
    "test:samsung": "npx playwright test --project=chromium-samsung-s26-ultra --project=firefox-samsung-s26-ultra --project=webkit-samsung-s26-ultra",
    "test:iphone": "npx playwright test --project=chromium-iphone-17-pro-max --project=firefox-iphone-17-pro-max --project=webkit-iphone-17-pro-max",
    "test:mobile": "npx playwright test --project=chromium-samsung-s26-ultra --project=firefox-samsung-s26-ultra --project=webkit-samsung-s26-ultra --project=chromium-iphone-17-pro-max --project=firefox-iphone-17-pro-max --project=webkit-iphone-17-pro-max",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "test:a11y": "npx playwright test tests/accessibility.spec.ts",
    "test:perf": "npx playwright test tests/performance.spec.ts",
    "test:cloud": "npx playwright test",
    "test:cloud:chromium": "npx playwright test --project=chromium",
    "test:all": "bash run-all-tests.sh",
    "allure:generate": "npx allure generate allure-results --clean --single-file -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results",
    "report": "npm run allure:generate && npm run allure:open",
    "report:serve": "npm run allure:serve",
    "clean": "rm -rf allure-results allure-report test-results playwright-report",
    "install:browsers": "npx playwright install --with-deps"
  },
  "keywords": [
    "automation",
    "playwright",
    "testing",
    "multibank",
    "allure"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.2",
    "allure-commandline": "^2.37.0",
    "allure-playwright": "^3.5.0",
    "dotenv": "^17.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
